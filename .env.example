# M365 Roadmap Automation via MRC MCP
# Configuration file for Microsoft 365 roadmap updates

# ============================================================================
# OAUTH 2.0 CONFIGURATION (Recommended - Modern Authentication)
# ============================================================================
# Uses Microsoft Graph API with OAuth 2.0 and MSAL
# Requires App Registration in Azure Active Directory

# Required: Azure App Registration Client ID
# Where to find: Azure Portal → Azure AD → App registrations → Your App → Client ID
OAUTH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Required: Azure Tenant ID
# Where to find: Azure Portal → Azure AD → App registrations → Your App → Tenant ID
OAUTH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: OAuth Redirect URI (default: http://localhost)
# For desktop applications, use: http://localhost
OAUTH_REDIRECT_URI=http://localhost

# ============================================================================
# EMAIL CONFIGURATION (via OAuth 2.0 / Microsoft Graph)
# ============================================================================

# Required: Your Microsoft 365 email address
# Example: user@company.onmicrosoft.com or user@yourdomain.com
EMAIL_FROM=your.email@empresa.com

# Required: Email address to send reports to
# Can be same as EMAIL_FROM or different recipient within your organization
EMAIL_TO=recipient@empresa.com

# ============================================================================
# LEGACY SMTP CONFIGURATION (Deprecated - Optional)
# ============================================================================
# Kept for backward compatibility, not used with OAuth
# EMAIL_PASSWORD=your_m365_app_password_here

# Roadmap filtering
# Number of months back to look for changes (default: 1 = last 30 days)
RSS_MONTHS_BACK=1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Dry run mode - test without sending emails
# Set to true to preview what would be sent without actually sending
DRY_RUN=false
