# M365 Roadmap Automation - Configuration Example
# Copy this file to .env and update with your actual values

# ============================================================================
# EXECUTION MODE
# ============================================================================

# Dry run mode - test without sending emails
# Set to true to preview what would be sent without actually sending
DRY_RUN=false

# Email sending mode: none, smtp, or graph
# - none: Email sending disabled (useful for testing)
# - smtp: Send via SMTP (Office 365, Exchange relay, etc.)
# - graph: Send via Microsoft Graph API (requires Azure App Registration)
EMAIL_MODE=smtp

# ============================================================================
# SCENARIO 1: DRY RUN (Development/Testing)
# ============================================================================
# For testing the application without sending emails
# Use DRY_RUN=true with EMAIL_MODE=none
#
# DRY_RUN=true
# EMAIL_MODE=none
#
# You can leave EMAIL_FROM/EMAIL_TO and other variables empty or unset.
# The application will skip all email configuration validation.

# ============================================================================
# SCENARIO 2: SMTP WITH AUTHENTICATION
# ============================================================================
# For Office 365 or authenticated SMTP servers
# Uncomment and configure:

# EMAIL_MODE=smtp
# EMAIL_FROM=your.email@empresa.com
# EMAIL_TO=recipient@empresa.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=your.email@empresa.com
# SMTP_PASSWORD=your_app_password_here

# ============================================================================
# SCENARIO 3: SMTP WITHOUT AUTHENTICATION (Exchange Relay)
# ============================================================================
# For on-premises Exchange relay or anonymous SMTP
# Uncomment and configure:

# EMAIL_MODE=smtp
# EMAIL_FROM=roadmap@empresa.com
# EMAIL_TO=recipient@empresa.com
# SMTP_HOST=exchange-relay.empresa.local
# SMTP_PORT=25
# SMTP_USE_TLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ============================================================================
# SCENARIO 4: MICROSOFT GRAPH (OAuth 2.0)
# ============================================================================
# For modern authentication via Microsoft Graph API
# Requires Azure App Registration (Entra ID)
# Uncomment and configure:

# EMAIL_MODE=graph
# EMAIL_FROM=your.email@empresa.com
# EMAIL_TO=recipient@empresa.com
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================================================
# ACTUAL CONFIGURATION (Choose One Scenario Above)
# ============================================================================

# For testing, use DRY_RUN mode:
DRY_RUN=true
EMAIL_MODE=none

# Or for production with SMTP:
# DRY_RUN=false
# EMAIL_MODE=smtp
# EMAIL_FROM=your.email@empresa.com
# EMAIL_TO=recipient@empresa.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=your.email@empresa.com
# SMTP_PASSWORD=your_app_password_here

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Number of months back to look for changes (default: 1 = last 30 days)
RSS_MONTHS_BACK=1
